APP_ENV=development
HTTP_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=300
# Per-source cache TTL overrides (seconds), merged over defaults in backend/app/config.py.
# Set from scripts/probe_cadence.py results, e.g.:
# REFRESH_TTL={"thaiwater-canal": 100, "flood-points": 120}
CACHE_MAX_ENTRIES=512
UPSTREAM_RETRIES=1

# GISTDA Disaster Platform API key (register at https://disaster.gistda.or.th/services/open-api).
# Enables satellite flood extent and recurring-flood layers; tiles are proxied so the key stays server-side.
GISTDA_API_KEY=

# Traffic layer (TomTom Traffic Flow tiles). Key stays server-side; tiles are proxied.
TOMTOM_API_KEY=

# TMD NWP forecast API token (https://data.tmd.go.th/nwpapi). Quota: 100,000 datapoints, 60 requests/min.
TMD_API_KEY=
# Keep this many datapoints available for national and high-priority lookups.
TMD_QUOTA_RESERVE=5000
# Local ceiling below TMD's upstream limit.
TMD_REQUESTS_PER_MINUTE=50
