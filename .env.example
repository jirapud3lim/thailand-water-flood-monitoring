APP_ENV=development
HTTP_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=300
# Per-source cache TTL overrides (seconds), merged over defaults in backend/app/config.py.
# Set from scripts/probe_cadence.py results, e.g.:
# REFRESH_TTL={"thaiwater-canal": 100, "flood-points": 120}
CACHE_MAX_ENTRIES=512
UPSTREAM_RETRIES=1

# Leave blank until an authorized GISTDA endpoint is confirmed.
GISTDA_FLOOD_URL=
GISTDA_API_KEY=
GISTDA_API_KEY_HEADER=api-key

